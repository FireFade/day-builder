# Copy this file to .env and fill your own values. Never share this file.
DATABASE_URL=sqlite:///./daybuilder.db
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# common = work/school and personal Microsoft accounts, when supported by app registration.
MICROSOFT_TENANT_ID=common
# Optional: DAYBUILDER_TOKEN_KEY=your-Fernet-key (local vault generates one automatically).

# Poll connected calendars automatically while start.ps1/server is running.
DAYBUILDER_AUTO_SYNC=1
# 15 minutes; allowed range 300..3600 seconds.
DAYBUILDER_SYNC_INTERVAL_SECONDS=900
